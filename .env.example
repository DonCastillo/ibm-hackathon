# LLM provider: "watsonx" (default) or "anthropic"
LLM_PROVIDER=watsonx

# IBM watsonx.ai credentials (required when LLM_PROVIDER=watsonx)
WATSONX_API_KEY=your_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Anthropic credentials (required when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Allow local repository paths (e.g. /Users/me/code/app) and file:// URLs.
# Keep this at 1 for local development. NEVER set it on a public deployment:
# it would let anyone read git repos stored on the server's disk.
ALLOW_LOCAL_REPOS=1
